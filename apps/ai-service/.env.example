# Sao chép thành .env nếu cần ghi đè mặc định. KHÔNG commit tệp .env.
AI_OLLAMA_URL=http://localhost:11434
AI_VISION_MODEL=qwen2.5vl:7b
AI_EMBED_MODEL=bge-m3
# Để trống = tìm kiếm tri thức theo từ khóa; điền để dùng vector (Qdrant)
AI_QDRANT_URL=
# Để trống = không yêu cầu X-API-Key
AI_API_KEY=
AI_VISION_ENABLED=true
AI_OCR_ENABLED=true
# --- Agent (POST /agent/diagnose) ---
# ollama = mô hình nội bộ có tool calling (ollama pull qwen2.5:7b); openai = ChatGPT hoặc Gemini
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=qwen2.5:7b
# Gemini: AI_LLM_PROVIDER=openai, AI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai,
#         AI_LLM_MODEL=gemini-2.0-flash, AI_LLM_API_KEY=<khóa Gemini>  (KHÔNG commit khóa)
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_AGENT_MAX_STEPS=6
# Cho agent đọc metrics thật từ backend Java
AI_BACKEND_URL=http://localhost:8080
