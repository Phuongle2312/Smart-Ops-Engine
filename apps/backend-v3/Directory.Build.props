<Project>

  <!-- Cấu hình dùng chung cho mọi project trong solution (xem docs/01_architecture/solid_clean_architecture.md §6) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Không bật InvariantGlobalization: Microsoft.Data.SqlClient cần dữ liệu culture -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Smart Ops Engine</Product>
    <Company>Smart Ops Engine</Company>
    <Version>3.0.0</Version>
  </PropertyGroup>

</Project>
