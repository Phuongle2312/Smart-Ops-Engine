# ============================================================
# Smart Ops Engine — biến môi trường mẫu (KHÔNG chứa giá trị thật)
# Copy file này thành .env (hoặc set trực tiếp bằng biến môi trường hệ thống/CI)
# rồi điền giá trị thật. KHÔNG commit file .env vào git.
# ============================================================

# --- Database (SQL Server) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=smart_ops_engine
DB_USERNAME=sa
DB_PASSWORD=

# --- SMTP relay nội bộ (Exchange tập đoàn) ---
# Xin thông tin từ IT: hostname/IP relay, port, có cần auth hay không.
# Kịch bản A (relay không auth, whitelist theo IP máy backend): để trống SMTP_USERNAME/SMTP_PASSWORD, SMTP_AUTH=false, SMTP_PORT=25
# Kịch bản B (Exchange domain account): SMTP_AUTH=true, SMTP_STARTTLS=true, SMTP_PORT=587, điền SMTP_USERNAME/SMTP_PASSWORD
SMTP_HOST=mail.tapdoan.local
SMTP_PORT=25
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Hộp thư nội bộ nhận cảnh báo
ALERT_RECIPIENT_EMAIL=

# --- Bảo mật ---
# AES key dùng mã hoá mật khẩu SSH của Node — bắt buộc, tối thiểu 32 ký tự (AES-256)
AES_SECRET_KEY=

# --- SSH (tuỳ chọn, có default trong application.properties) ---
SSH_CONNECT_TIMEOUT_MS=15000
SSH_COMMAND_TIMEOUT_MS=40000

# --- AI chẩn đoán ảnh (ai-service) ---
AI_ENABLED=true
AI_SERVICE_URL=http://localhost:8001
# Khớp với AI_API_KEY của ai-service; để trống nếu ai-service không yêu cầu
AI_API_KEY=
AI_TIMEOUT_MS=180000
