# Sao chép thành .env và điền giá trị thật. KHÔNG commit tệp .env (NFR-SEC-007).

# Mật khẩu tài khoản sa của SQL Server (bắt buộc)
SQL_SA_PASSWORD=Doi_Mat_Khau_Nay_123

# Mật khẩu khởi tạo cho tài khoản admin; để trống thì hệ thống sinh ngẫu nhiên và ghi ra log một lần
INITIAL_ADMIN_PASSWORD=

# Khóa riêng RSA (PKCS#8, PEM) dùng ký JWT RS256. Để trống ở môi trường dev sẽ tự sinh khóa tạm.
# Sinh khóa: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
JWT_PRIVATE_KEY_PEM=

# Origin của frontend được phép gọi API (CORS whitelist)
FRONTEND_ORIGIN=http://localhost:5173

# Tag image
TAG=dev
